# =================================================================
# VIRTUAL FURNITURE STORE - ENVIRONMENT CONFIGURATION
# =================================================================

# Backend Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL / PostgreSQL)
DB_URL=jdbc:mysql://localhost:3306/furniture_store?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# MongoDB (Spatial & Room Visualization Sessions)
MONGO_URI=mongodb://localhost:27017/furniture_store

# Spring Security & JWT Configuration
JWT_SECRET=d2FybS13YWxudXQtZnVybml0dXJlLXNlY3JldC1rZXktYXV0aC1zZXJ2aWNlLTIwMjY=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Object Storage (AWS S3 / MinIO)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=furniture-store-assets
S3_ENDPOINT=http://localhost:9000

# Payment Provider (Razorpay / Mock)
PAYMENT_PROVIDER_KEY=rzp_test_key_sample
PAYMENT_PROVIDER_SECRET=rzp_test_secret_sample

# Frontend Environment Variables (exposed to client)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Virtual Furniture Store
NEXT_PUBLIC_ENABLE_AR=true
NEXT_PUBLIC_S3_BASE_URL=http://localhost:9000/furniture-store-assets
